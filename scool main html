<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Discord-Style Chat</title>

<!-- PeerJS (WebRTC, no backend) -->
<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>

<style>
:root {
  --bg: #313338;
  --sidebar: #1e1f22;
  --channel: #2b2d31;
  --chat: #313338;
  --input: #383a40;
  --text: #dbdee1;
  --muted: #949ba4;
  --accent: #5865f2;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  height: 100vh;
  display: flex;
  font-family: "gg sans", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}

/* SERVER BAR */
#servers {
  width: 72px;
  background: #1e1f22;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10px;
}

.server {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--accent);
  margin-bottom: 10px;
}

/* CHANNEL BAR */
#channels {
  width: 240px;
  background: var(--channel);
  padding: 10px;
}

.channel {
  padding: 8px;
  color: var(--muted);
  cursor: pointer;
}

.channel:hover {
  background: #3f4147;
  color: white;
  border-radius: 4px;
}

/* CHAT */
#chat-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

#header {
  height: 48px;
  background: #2b2d31;
  display: flex;
  align-items: center;
  padding: 0 16px;
  border-bottom: 1px solid #1f2023;
}

#messages {
  flex: 1;
  padding: 16px;
  overflow-y: auto;
}

.message {
  margin-bottom: 12px;
}

.username {
  font-weight: bold;
  margin-right: 6px;
}

#input-bar {
  padding: 10px;
  background: #2b2d31;
}

#input-bar input {
  width: 100%;
  background: var(--input);
  border: none;
  color: white;
  padding: 12px;
  border-radius: 8px;
  outline: none;
}

/* VIDEO */
#video {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #000;
  padding: 10px;
  border-radius: 10px;
}

video {
  width: 160px;
  border-radius: 6px;
  margin: 3px;
}

button {
  background: var(--accent);
  border: none;
  color: white;
  padding: 6px 10px;
  border-radius: 5px;
  cursor: pointer;
}
</style>
</head>

<body>

<!-- SERVERS -->
<div id="servers">
  <div class="server"></div>
</div>

<!-- CHANNELS -->
<div id="channels">
  <h4>TEXT CHANNELS</h4>
  <div class="channel"># general</div>
</div>

<!-- CHAT -->
<div id="chat-area">
  <div id="header"># general</div>

  <div id="messages"></div>

  <div id="input-bar">
    <input id="msg" placeholder="Message #general" />
  </div>
</div>

<!-- VIDEO -->
<div id="video">
  <video id="local" autoplay muted></video>
  <video id="remote" autoplay></video>
  <br>
  <input id="peerId" placeholder="Friend ID" style="width:100%;margin-top:5px">
  <button onclick="connect()">Connect</button>
  <button onclick="callPeer()">Call</button>
  <p style="font-size:11px">Your ID: <span id="myId"></span></p>
</div>

<script>
const peer = new Peer();
let conn;
let call;
let localStream;
const messages = document.getElementById("messages");

peer.on("open", id => {
  document.getElementById("myId").innerText = id;
});

peer.on("connection", c => {
  conn = c;
  conn.on("data", addMessage);
});

peer.on("call", async incoming => {
  localStream = await navigator.mediaDevices.getUserMedia({video:true,audio:true});
  document.getElementById("local").srcObject = localStream;
  incoming.answer(localStream);
  incoming.on("stream", s => document.getElementById("remote").srcObject = s);
});

function connect() {
  const id = document.getElementById("peerId").value;
  conn = peer.connect(id);
  conn.on("data", addMessage);
}

document.getElementById("msg").addEventListener("keydown", e => {
  if (e.key === "Enter") sendMsg();
});

function sendMsg() {
  const input = document.getElementById("msg");
  const text = input.value;
  if (!text || !conn) return;
  addMessage({ user: "You", text });
  conn.send({ user: "Friend", text });
  input.value = "";
}

function addMessage(m) {
  const div = document.createElement("div");
  div.className = "message";
  div.innerHTML = `<span class="username">${m.user}</span>${m.text}`;
  messages.appendChild(div);
  messages.scrollTop = messages.scrollHeight;
}

async function callPeer() {
  const id = document.getElementById("peerId").value;
  localStream = await navigator.mediaDevices.getUserMedia({video:true,audio:true});
  document.getElementById("local").srcObject = localStream;
  call = peer.call(id, localStream);
  call.on("stream", s => document.getElementById("remote").srcObject = s);
}
</script>

</body>
</html>
