<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Discord-Style Clone</title>
<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>

<style>
:root {
  --bg:#313338; --sidebar:#1e1f22; --panel:#2b2d31;
  --text:#dbdee1; --muted:#949ba4; --accent:#5865f2;
}
*{box-sizing:border-box}
body{
  margin:0; display:flex; height:100vh;
  font-family:Arial; background:var(--bg); color:var(--text)
}
#servers{width:72px;background:var(--sidebar);padding:10px}
.server{width:48px;height:48px;border-radius:50%;background:var(--accent);margin-bottom:10px}

#channels{width:240px;background:var(--panel);padding:10px}
.channel{padding:6px;cursor:pointer;color:var(--muted)}
.channel.active{background:#3f4147;color:white;border-radius:4px}

#chat{flex:1;display:flex;flex-direction:column}
#header{height:48px;background:var(--panel);display:flex;align-items:center;padding:10px}
#messages{flex:1;padding:10px;overflow-y:auto}
.msg{margin-bottom:8px}
.user{font-weight:bold;margin-right:5px}

#input{padding:10px;background:var(--panel)}
#input input{width:100%;padding:10px;border-radius:8px;border:none;background:#383a40;color:white}

#right{width:240px;background:var(--panel);padding:10px}
button{background:var(--accent);border:none;color:white;padding:6px;border-radius:5px;cursor:pointer;margin-top:5px}
input{width:100%;padding:6px;margin-top:5px;border-radius:5px;border:none}
video{width:100%;margin-top:5px;border-radius:6px;background:black}
</style>
</head>

<body>

<!-- SERVERS -->
<div id="servers">
  <div class="server"></div>
</div>

<!-- CHANNELS -->
<div id="channels">
  <h4>CHANNELS</h4>
  <div id="channelList"></div>
  <input id="newChannel" placeholder="New channel">
  <button onclick="addChannel()">Add</button>
</div>

<!-- CHAT -->
<div id="chat">
  <div id="header"># <span id="channelName"></span></div>
  <div id="messages"></div>
  <div id="input">
    <input id="msg" placeholder="Message" />
  </div>
</div>

<!-- FRIENDS -->
<div id="right">
  <h4>User</h4>
  <b id="myName"></b>
  <h4>Add Friend</h4>
  <input id="friendName" placeholder="Friend username">
  <button onclick="addFriend()">Add Friend</button>

  <h4>Friends</h4>
  <div id="friends"></div>

  <h4>Call</h4>
  <video id="local" autoplay muted></video>
  <video id="remote" autoplay></video>
</div>

<script>
// ---------- USER ----------
const username = prompt("Choose a username (short):");
document.getElementById("myName").innerText = username;

// ---------- PEER ----------
const peer = new Peer(username);
let conn;
let currentChannel = "general";
let channels = ["general"];
let friends = {};
let streams;

// ---------- CHANNELS ----------
function renderChannels(){
  const list = document.getElementById("channelList");
  list.innerHTML="";
  channels.forEach(c=>{
    const div=document.createElement("div");
    div.className="channel"+(c===currentChannel?" active":"");
    div.innerText="# "+c;
    div.onclick=()=>switchChannel(c);
    list.appendChild(div);
  });
  document.getElementById("channelName").innerText=currentChannel;
}
function addChannel(){
  const c=document.getElementById("newChannel").value;
  if(c && !channels.includes(c)){channels.push(c);renderChannels();}
}
function switchChannel(c){
  currentChannel=c;
  document.getElementById("messages").innerHTML="";
  renderChannels();
}

// ---------- CHAT ----------
document.getElementById("msg").addEventListener("keydown",e=>{
  if(e.key==="Enter")sendMsg();
});
function sendMsg(){
  const text=msg.value;
  if(!text||!conn)return;
  addMsg(username,text);
  conn.send({type:"msg",channel:currentChannel,user:username,text});
  msg.value="";
}
function addMsg(u,t){
  const d=document.createElement("div");
  d.className="msg";
  d.innerHTML=`<span class="user">${u}</span>${t}`;
  messages.appendChild(d);
  messages.scrollTop=messages.scrollHeight;
}

// ---------- FRIENDS ----------
function addFriend(){
  const f=document.getElementById("friendName").value;
  conn=peer.connect(f);
  conn.on("data",handleData);
  friends[f]=conn;
  renderFriends();
}
function renderFriends(){
  const f=document.getElementById("friends");
  f.innerHTML="";
  Object.keys(friends).forEach(n=>{
    const d=document.createElement("div");
    d.innerText=n;
    d.onclick=()=>conn=friends[n];
    f.appendChild(d);
  });
}

// ---------- DATA ----------
peer.on("connection",c=>{
  conn=c;
  conn.on("data",handleData);
});
function handleData(d){
  if(d.type==="msg" && d.channel===currentChannel){
    addMsg(d.user,d.text);
  }
}

// ---------- CALL ----------
async function callFriend(name){
  const stream=await navigator.mediaDevices.getUserMedia({video:true,audio:true});
  local.srcObject=stream;
  const call=peer.call(name,stream);
  call.on("stream",s=>remote.srcObject=s);
}
document.getElementById("friends").addEventListener("dblclick",e=>{
  callFriend(e.target.innerText);
});

renderChannels();
</script>

</body>
</html>
